# =============================================================================
# Nyaya - example environment. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored and must never be committed.
# Every value below is a safe default; only NYAYA_LLM_API_KEY needs your input,
# and even that is optional if you run the Ollama path (see README).
# =============================================================================

# ---- app ---------------------------------------------------------------------
NYAYA_ENV=development                  # development | production. Controls log format + docs exposure.
NYAYA_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
NYAYA_API_PORT=8000                    # port the API binds inside the container
NYAYA_SESSION_SECRET=change-me-to-a-random-32-byte-string   # HMAC key for anonymous session cookies. Generate: openssl rand -hex 32

# ---- postgres (relational: conversations, documents, jobs, feedback, forms) --
POSTGRES_USER=nyaya
POSTGRES_PASSWORD=nyaya_local_dev_only  # local compose only; never reuse in a deployed environment
POSTGRES_DB=nyaya
POSTGRES_HOST=postgres                  # service name on the compose network
POSTGRES_PORT=5432

# ---- redis (task queue, cache, rate limiting) --------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- vector store ------------------------------------------------------------
NYAYA_VECTOR_STORE=qdrant              # qdrant | pgvector. Both implement VectorStore; see DECISIONS.md
QDRANT_URL=http://qdrant:6333          # dashboard: http://localhost:6333/dashboard
QDRANT_COLLECTION_STATUTE=nyaya_statute   # the bare act; rebuilt by bootstrap
QDRANT_COLLECTION_DOCS=nyaya_documents    # user uploads, always filtered by session_id

# ---- embeddings + rerank (open-weight, run locally via ONNX) -----------------
NYAYA_EMBED_MODEL=BAAI/bge-small-en-v1.5  # 384-dim, 67MB. Alt: BAAI/bge-base-en-v1.5 (768-dim, 210MB)
NYAYA_EMBED_DIM=384                        # MUST match the model, or the collection is built wrong
NYAYA_EMBED_QUERY_PREFIX=                  # bge-v1.5 needs none. e5-*: "query: ". nomic-*: "search_query: "
NYAYA_EMBED_PASSAGE_PREFIX=                # e5-*: "passage: ". nomic-*: "search_document: "
NYAYA_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
NYAYA_RERANK_ENABLED=true
NYAYA_RERANK_TOP_K=30                      # candidates fed to the cross-encoder
NYAYA_RERANK_KEEP=6                        # passages kept for generation

# ---- retrieval thresholds (the refusal path) ---------------------------------
NYAYA_CONFIDENCE_HIGH=0.55             # >= this: answer normally
NYAYA_CONFIDENCE_LOW=0.30              # <  this: rewrite + retry once, then refuse
NYAYA_RRF_K=60                         # reciprocal-rank-fusion constant
NYAYA_HYBRID_CANDIDATES=50             # rows pulled from each of dense + full-text before fusion

# ---- LLM provider (generation only; retrieval never calls a hosted API) ------
NYAYA_LLM_PROVIDER=groq                # groq | ollama | openrouter | gemini
NYAYA_LLM_MODEL=llama-3.3-70b-versatile
NYAYA_LLM_API_KEY=                     # leave EMPTY for the ollama provider
NYAYA_LLM_BASE_URL=                    # override for self-hosted/proxy; blank uses provider default
NYAYA_LLM_TIMEOUT_S=60
NYAYA_LLM_MAX_TOKENS=1024
NYAYA_LLM_TEMPERATURE=0.1              # low: this is a citation task, not a creative one

# Ollama path (no API key required - see README "Running without an API key")
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ---- uploads -----------------------------------------------------------------
NYAYA_MAX_UPLOAD_MB=25
NYAYA_ALLOWED_MIME=application/pdf,image/png,image/jpeg,text/plain
NYAYA_UPLOAD_DIR=/data/uploads

# ---- rate limiting -----------------------------------------------------------
NYAYA_RATE_LIMIT_CHAT=30/minute
NYAYA_RATE_LIMIT_UPLOAD=10/hour

# ---- ingestion ---------------------------------------------------------------
NYAYA_SOURCE_PDF=/data/raw/bnss_2023.pdf
NYAYA_FORMS_PAGE_START=190             # Second Schedule, first form page
NYAYA_FORMS_PAGE_END=249               # last page of the volume
NYAYA_OCR_ENABLED=true                 # fallback only; logged whenever it fires
NYAYA_OCR_LANG=eng

# ---- cost accounting (README reports cost per query) -------------------------
NYAYA_COST_PER_1M_INPUT_USD=0.59       # provider rate; used by /api/v1/metrics
NYAYA_COST_PER_1M_OUTPUT_USD=0.79

# ---- frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
