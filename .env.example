# =============================================================================
# Nyaya - environment configuration
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
#
# Only SECTION 1 needs your attention. Section 2 is wiring that docker-compose
# already sets. Section 3 is tuning: every one of those values has a working
# default in backend/app/core/config.py, so the lines are commented out and
# listed here only so you can see what exists and override it if you want to.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED - secrets, and the choices only you can make
# -----------------------------------------------------------------------------

# Signs the anonymous session cookie that owns conversations and uploads.
# Generate one:  openssl rand -hex 32
NYAYA_SESSION_SECRET=change-me-run-openssl-rand-hex-32

# Which model writes the answer. Retrieval never calls a hosted API; this is
# generation only.
#   groq        fast, free tier             -> needs NYAYA_LLM_API_KEY
#   ollama      fully local, no key at all  -> see README, "Running without an API key"
#   openrouter  | gemini                    -> need NYAYA_LLM_API_KEY
NYAYA_LLM_PROVIDER=groq
NYAYA_LLM_MODEL=llama-3.3-70b-versatile

# Leave EMPTY when NYAYA_LLM_PROVIDER=ollama.
NYAYA_LLM_API_KEY=

# Local database password. Fine as-is under docker-compose; change it anywhere real.
POSTGRES_PASSWORD=nyaya_local_dev_only


# -----------------------------------------------------------------------------
# 2. SERVICE WIRING - docker-compose sets these; override only when running
#    the API outside compose
# -----------------------------------------------------------------------------

POSTGRES_USER=nyaya
POSTGRES_DB=nyaya
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_URL=http://qdrant:6333          # dashboard: http://localhost:6333/dashboard

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Managed hosts (Render, Neon, Upstash) hand out a single connection URL.
# When present these win over the discrete values above.
# DATABASE_URL=
# REDIS_URL=

# Only read when NYAYA_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct


# -----------------------------------------------------------------------------
# 3. OPTIONAL TUNING - defaults live in backend/app/core/config.py
#
# Nothing below needs setting. The values shown ARE the defaults, repeated here
# as documentation. Uncomment a line only to change it.
# -----------------------------------------------------------------------------

# --- app ---
# NYAYA_ENV=development                     # development | production
# NYAYA_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
# NYAYA_API_PORT=8000

# --- embeddings and reranking (open weights, run locally on ONNX) ---
# NYAYA_EMBED_MODEL=BAAI/bge-small-en-v1.5  # 384-dim, 67MB. Alt: BAAI/bge-base-en-v1.5 (768-dim, 210MB)
# NYAYA_EMBED_DIM=384                       # MUST match the model, or the collection is built wrong
# NYAYA_EMBED_QUERY_PREFIX=                 # bge needs none. e5-*: "query: ". nomic-*: "search_query: "
# NYAYA_EMBED_PASSAGE_PREFIX=               # e5-*: "passage: ". nomic-*: "search_document: "
# NYAYA_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# NYAYA_RERANK_ENABLED=true
# NYAYA_RERANK_TOP_K=30                     # candidates handed to the cross-encoder
# NYAYA_RERANK_KEEP=6                       # passages kept for generation

# --- the refusal path ---
# NYAYA_CONFIDENCE_HIGH=0.55                # >= this: answer normally
# NYAYA_CONFIDENCE_LOW=0.30                 # <  this: rewrite and retry once, then refuse
# NYAYA_RRF_K=60                            # reciprocal-rank-fusion constant
# NYAYA_HYBRID_CANDIDATES=50                # rows pulled from dense and from sparse before fusion

# --- generation ---
# NYAYA_LLM_BASE_URL=                       # override for a proxy or self-hosted endpoint
# NYAYA_LLM_TIMEOUT_S=60
# NYAYA_LLM_MAX_TOKENS=1024
# NYAYA_LLM_TEMPERATURE=0.1                 # low: this is a citation task, not a creative one

# --- vector store ---
# NYAYA_VECTOR_STORE=qdrant                 # qdrant | pgvector
# QDRANT_COLLECTION_STATUTE=nyaya_statute
# QDRANT_COLLECTION_DOCS=nyaya_documents

# --- uploads ---
# NYAYA_MAX_UPLOAD_MB=25
# NYAYA_ALLOWED_MIME=application/pdf,image/png,image/jpeg,text/plain
# NYAYA_UPLOAD_DIR=/data/uploads

# --- rate limiting ---
# NYAYA_RATE_LIMIT_CHAT=30/minute
# NYAYA_RATE_LIMIT_UPLOAD=10/hour

# --- ingestion ---
# NYAYA_SOURCE_PDF=/data/raw/bnss_2023.pdf
# NYAYA_FORMS_PAGE_START=190                # Second Schedule, first form page
# NYAYA_FORMS_PAGE_END=249
# NYAYA_OCR_ENABLED=true                    # fallback only; logged whenever it fires
# NYAYA_OCR_LANG=eng

# --- cost accounting (reported per query on /api/v1/metrics) ---
# NYAYA_COST_PER_1M_INPUT_USD=0.59          # provider rate
# NYAYA_COST_PER_1M_OUTPUT_USD=0.79
