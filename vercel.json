{
  "name": "Nyaya",
  "version": 1,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "env": {
    "NEXT_PUBLIC_API_URL": {
      "description": "Backend API URL (e.g., https://nyaya-api.onrender.com)"
    }
  },
  "github": {
    "enabled": true,
    "autoDeployOnPush": true
  }
}
